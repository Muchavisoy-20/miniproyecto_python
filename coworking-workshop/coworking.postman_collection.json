{
  "info": {
    "_postman_id": "c1f7a28e-5b1e-4c92-b883-91db4b20a7b4",
    "name": "Coworking Space Microservices - Diplomado",
    "description": "Colección completa de pruebas para los microservicios catalog-service (8001) y orders-service (8002).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Catalog Service",
      "item": [
        {
          "name": "Health Check (Catalog)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8001/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8001",
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Service is catalog-service', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.service).to.eql('catalog-service');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List All Spaces",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8001/spaces",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8001",
              "path": ["spaces"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns list of spaces', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Space by ID (ID: 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8001/spaces/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8001",
              "path": ["spaces", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Contains price_per_hour contract', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('price_per_hour');",
                  "    pm.expect(json.id).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Space Availability",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8001/spaces/1/availability",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8001",
              "path": ["spaces", "1", "availability"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Orders Service",
      "item": [
        {
          "name": "Health Check (Orders)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8002/health",
              "protocol": "http",
              "host": ["localhost"],
