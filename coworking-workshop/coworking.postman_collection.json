                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Order (Success)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8002/orders?space_id=1&user_email=test@example.com&hours=2",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8002",
              "path": ["orders"],
              "query": [
                {
                  "key": "space_id",
                  "value": "1"
                },
                {
                  "key": "user_email",
                  "value": "test@example.com"
                },
                {
                  "key": "hours",
                  "value": "2"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 (Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Order calculated correctly', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('CONFIRMED');",
                  "    pm.expect(json.total_price).to.eql(50.0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8002/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8002",
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8002/orders/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8002",
              "path": ["orders", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Chaos Engineering Tests",
      "item": [
        {
          "name": "Chaos: Order on Unavailable Space (400)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8002/orders?space_id=4&user_email=usuario@ejemplo.com&hours=3",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8002",
              "path": ["orders"],
              "query": [
                {
                  "key": "space_id",
                  "value": "4"
                },
                {
                  "key": "user_email",
                  "value": "usuario@ejemplo.com"
                },
                {
                  "key": "hours",
                  "value": "3"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Chaos: Order on Non-Existent Space (404)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8002/orders?space_id=9999&user_email=usuario@ejemplo.com&hours=1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8002",
              "path": ["orders"],
              "query": [
                {
                  "key": "space_id",
                  "value": "9999"
                },
                {
                  "key": "user_email",
                  "value": "usuario@ejemplo.com"
                },
                {
                  "key": "hours",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
